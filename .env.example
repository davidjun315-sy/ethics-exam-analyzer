# Export this variable before starting; .env is not loaded automatically.
DATABASE_URL=sqlite:///./ethics.db
# PostgreSQL alternative:
# DATABASE_URL=postgresql+psycopg://ethics:ethics@localhost:5432/ethics

# Uploaded PDF originals (ignored by Git)
PDF_STORAGE_DIR=storage/pdfs

# Local defaults; production settings are in deploy/production.env.example
MULTIMODAL_PROVIDER=mock
JOB_BACKEND=inline
OBJECT_STORAGE_BACKEND=local
ASSET_STORAGE_DIR=storage/assets
